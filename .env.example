# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never prefix with NEXT_PUBLIC_. Used only in server actions /
# route handlers for moderation and admin operations. Never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL of the deployed app, used to build absolute links (e.g. the
# one-time "delete your confession" link shown at submission).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Moderation backend for submitted confessions and replies: "mock" (the
# default — a local keyword/PII heuristic, NOT real safety moderation) or
# "anthropic" (Claude-based classification — see src/lib/moderation/).
MODERATION_PROVIDER=mock

# Server-only. Required only when MODERATION_PROVIDER=anthropic. Get one at
# https://console.anthropic.com. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Server-only. The single shared passphrase for /admin — there are no
# per-moderator accounts. Pick something long; it's the only thing
# standing between the public internet and the moderation queue.
ADMIN_PASSWORD=change-me-to-something-long-and-random

# Server-only. Signs the stateless /admin session cookie. Generate with
# `openssl rand -base64 32`. Must be different from ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=change-me-to-a-random-secret
